FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    default-mysql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY versioning/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
#COPY versioning/multi_site_versioning.py .
#COPY versioning/versioning_service.py .
#COPY versioning/common_utils.py .
#COPY versioning/rabbitmq_integration.py .
COPY versioning/. .


# Create necessary directories
RUN mkdir -p models/versions logs

# Expose port
EXPOSE 5002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5002/health || exit 1

# Run with 1 worker for beta environment
CMD ["gunicorn", "--bind", "0.0.0.0:5002", "--workers", "1", "--timeout", "120", "versioning_service:app"]
